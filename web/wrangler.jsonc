{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pachinko",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",

  // The custom domain is the only public hostname.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "pachinko.twinspear.com", "custom_domain": true }],

  // The Godot export, staged by scripts/stage.ts. /index.wasm and /api/* are not
  // files here, so those requests fall through to the Worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pachinko",
      "database_id": "995b7f26-fc68-4bc8-81c3-0fd0a93f8165",
      "migrations_dir": "migrations"
    }
  ]
}
