; Engine configuration file.
; Godot 4.7, GDScript only (the web export cannot run C#).

config_version=5

[application]

config/name="Pachinko Descent"
config/description="Shoot the descending House; every wreck drops a ball through the pins."
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0.035, 0.03, 0.07, 1)
config/icon="res://icon.svg"

[autoload]

Profile="*res://scripts/autoload/profile.gd"
Sfx="*res://scripts/autoload/sfx.gd"
Telemetry="*res://scripts/autoload/telemetry.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/energy_saving/keep_screen_on=true
window/handheld/orientation=1

[gui]

theme/default_font_multichannel_signed_distance_field=false

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
2d/snap/snap_2d_transforms_to_pixel=false
anti_aliasing/quality/msaa_2d=1
environment/defaults/default_clear_color=Color(0.035, 0.03, 0.07, 1)
